SECRET_KEY=change-me-to-a-long-random-string
UI_PASSWORD=change-me           # used once to create initial admin user
API_KEY=change-me-to-a-long-random-api-key
APP_URL=https://markd.appfoundry.cc
INITIAL_ADMIN_EMAIL=you@example.com
# Optional: override default sqlite path
# DATABASE_URL=sqlite:////absolute/path/to/markd.db

# Email (Resend)
RESEND_API_KEY=
# Sends from a dedicated mail subdomain so app-mail reputation stays separate
# from the root domain. The free Resend plan verifies only ONE domain, so this
# means deleting appfoundry.cc and adding mail.appfoundry.cc in its place —
# sending is down until the new one verifies. Keep this on the old address
# until then; see deploy/README.md step 1 for the sequence.
EMAIL_FROM=Markd <markd@mail.appfoundry.cc>
# Signing secret from the Resend webhook (starts "whsec_"). Without it the
# bounce/complaint suppression endpoint rejects everything.
RESEND_WEBHOOK_SECRET=

# Signup anti-bot. The honeypot, timing trap, rate limits and MX validation are
# always on. Turnstile only activates once both keys are set — get them free at
# https://dash.cloudflare.com -> Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional newline-delimited extra disposable-domain blocklist
# DISPOSABLE_DOMAINS_FILE=/var/www/markd/Web/disposable-domains.txt
# Unverified accounts older than this are deleted by purge_stale_signups.py
PURGE_UNVERIFIED_DAYS=7

# Push notifications — generated automatically by setup.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:your@email.com
